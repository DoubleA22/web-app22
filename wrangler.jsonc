{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-app22",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "389b2494-fcfb-44da-9eaa-ecb4e2ced385","database_name": "web-app" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "234224108664427c90bc3e36dfab33db" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
